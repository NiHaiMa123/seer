{
  "name": "seer-reborn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Seer Reborn — synthetic-v1 engineering slice. See README.md and docs/roadmap.md.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "content:validate": "node tools/content-validate.ts content",
    "content:validate:selftest": "node tools/content-validate.ts --selftest",
    "contracts:gen": "node tools/gen-contract-types.ts",
    "contracts:check": "node tools/gen-contract-types.ts --check",
    "test:contracts": "vitest run tests/contracts/contracts.test.ts",
    "test:privacy": "vitest run tests/contracts/privacy.test.ts",
    "test:plugin": "vitest run experiments/cordis/tests",
    "test:determinism": "vitest run experiments/determinism/tests/determinism.test.ts",
    "test:core": "vitest run tests/battle-core",
    "test:protocol": "vitest run tests/host",
    "test:determinism:browser": "node tools/build-det-bundle.ts && playwright test determinism",
    "perf:render": "node tools/build-render-bundle.ts && playwright test render",
    "verify:m0": "node tools/verify-m0.ts",
    "vectors:gen": "node experiments/determinism/scripts/gen-vectors.ts",
    "check:boundaries": "node tools/check-boundaries.ts"
  },
  "devDependencies": {
    "@seer/battle-core": "workspace:*",
    "@seer/contracts": "workspace:*",
    "@seer/host": "workspace:*",
    "@types/node": "24.13.5",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "ajv": "8.17.1",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
