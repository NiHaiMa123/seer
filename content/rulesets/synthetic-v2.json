{
  "rulesetId": "synthetic-v2",
  "rulesetVersion": "2.0.0",
  "schemaVersion": 1,
  "verification": "SYNTHETIC",
  "features": ["bench", "damage_kinds", "control", "revive", "stat_ops", "mode_overlay"],
  "operatorAllowlist": [
    "damage",
    "apply_stat_stage",
    "heal",
    "transfer_stages",
    "clear_stages",
    "control",
    "cleanse",
    "apply_status",
    "apply_effect"
  ],
  "stats": ["hp", "atk", "def", "spa", "sdf", "spd"],
  "statStageRange": [-6, 6],
  "damageKinds": ["standard", "fixed", "percent", "true"],
  "typeChartFile": "typechart.json",
  "stabMultiplier": 1.5,
  "statModel": "six-stat",
  "naturesFile": "natures.json",
  "modeOverlays": {
    "boss": { "immuneControl": true, "immuneClearStages": true }
  },
  "limits": {
    "maxEffectApplications": 4096,
    "maxCauseDepth": 64,
    "maxTurns": 200,
    "maxBenchSize": 2
  },
  "rng": {
    "algorithmId": "xoshiro128**",
    "usage": ["order_tiebreak", "damage_roll"]
  }
}
