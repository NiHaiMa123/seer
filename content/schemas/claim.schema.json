{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "seer/claim.schema.json",
  "title": "Original-game rule claim (see docs/data-and-content.md)",
  "type": "object",
  "required": ["claimId", "targetSnapshot", "mode", "statement", "boundaries", "source", "observedAt", "evidenceDigest", "reviewer", "verification", "fixtureIds"],
  "additionalProperties": false,
  "properties": {
    "claimId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" },
    "targetSnapshot": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "boundaries": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["kind", "uri"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["official", "observation", "community", "other"] },
        "uri": { "type": "string", "minLength": 1 }
      }
    },
    "observedAt": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2}|unknown)$" },
    "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reviewer": { "type": "string", "minLength": 1 },
    "verification": { "enum": ["SYNTHETIC", "UNVERIFIED", "VERIFIED", "CONFLICTED"] },
    "fixtureIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
