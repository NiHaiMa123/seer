{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "seer/pack.schema.json",
  "title": "Content pack manifest",
  "type": "object",
  "required": ["packId", "version", "schemaVersion", "rulesetId", "verification", "license", "files", "assets"],
  "additionalProperties": false,
  "properties": {
    "packId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "rulesetId": { "type": "string", "minLength": 1 },
    "verification": { "enum": ["SYNTHETIC", "UNVERIFIED", "VERIFIED", "CONFLICTED"] },
    "license": { "$ref": "#/definitions/license" },
    "files": {
      "type": "object",
      "required": ["units", "moves"],
      "additionalProperties": false,
      "properties": {
        "units": { "type": "string", "minLength": 1 },
        "moves": { "type": "string", "minLength": 1 }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "digest", "license"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "license": { "$ref": "#/definitions/license" }
        }
      }
    }
  },
  "definitions": {
    "license": {
      "type": "object",
      "required": ["identifier", "public"],
      "additionalProperties": false,
      "properties": {
        "identifier": { "type": "string" },
        "public": { "type": "boolean" },
        "reference": { "type": "string" }
      }
    }
  }
}
