{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "seer/moves.schema.json",
  "type": "object",
  "required": ["moves"],
  "additionalProperties": false,
  "properties": {
    "moves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "pp", "priority", "effects"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "pp": { "type": "integer", "minimum": 1 },
          "priority": { "type": "integer" },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["op"],
              "additionalProperties": false,
              "properties": {
                "op": { "type": "string", "minLength": 1 },
                "power": { "type": "integer", "minimum": 1 },
                "stat": { "enum": ["atk", "def", "spd"] },
                "delta": { "type": "integer", "not": { "const": 0 } },
                "target": { "enum": ["self", "opponent"] },
                "numerator": { "type": "integer", "minimum": 1 },
                "denominator": { "type": "integer", "minimum": 1 }
              },
              "allOf": [
                {
                  "if": { "required": ["op"], "properties": { "op": { "const": "damage" } } },
                  "then": { "required": ["power"], "properties": { "power": true } }
                },
                {
                  "if": { "required": ["op"], "properties": { "op": { "const": "apply_stat_stage" } } },
                  "then": {
                    "required": ["stat", "delta", "target"],
                    "properties": { "stat": true, "delta": true, "target": true }
                  }
                },
                {
                  "if": { "required": ["op"], "properties": { "op": { "const": "heal" } } },
                  "then": {
                    "required": ["numerator", "denominator", "target"],
                    "properties": { "numerator": true, "denominator": true, "target": true }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
